#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    /* Conditional layers */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    /* Home row mods */
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 54 55 56>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50>;
        };

        // Tap-dance: dot variations
        td_dot: tap_dance_dot {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_DOT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DOT>, <&macro_dot_dot>;
        };

        // Tap-dance: space/underscore
        td_spc: tap_dance_space {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SPACE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SPACE>, <&kp UNDER>;
        };

        // Mod-morph: dot to colon with shift
        mm_dot: mod_morph_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_DOT";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Mod-morph: comma to semicolon with shift
        mm_comma: mod_morph_comma {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_MORPH_COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    /* Macros */
    macros {
        macro_dot_dot: macro_dot_dot {
            compatible = "zmk,behavior-macro";
            label = "MACRO_DOT_DOT";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DOT>;
        };

        macro_ellipsis: macro_ellipsis {
            compatible = "zmk,behavior-macro";
            label = "MACRO_ELLIPSIS";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DOT &kp DOT>;
        };

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            label = "MACRO_BRACES";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            label = "MACRO_BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            label = "MACRO_PARENS";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };

        macro_arrow: macro_arrow {
            compatible = "zmk,behavior-macro";
            label = "MACRO_ARROW";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        macro_fat_arrow: macro_fat_arrow {
            compatible = "zmk,behavior-macro";
            label = "MACRO_FAT_ARROW";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
    };

    /* Combos */
    combos {
        compatible = "zmk,combos";

        // ESC combos (Vim-style)
        combo_esc_wf {
            timeout-ms = <50>;
            key-positions = <14 15>;  // W+F
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_esc_lu {
            timeout-ms = <50>;
            key-positions = <19 20>;  // L+U
            bindings = <&kp ESC>;
            layers = <0>;
        };

        // Bracket pairs
        combo_braces {
            timeout-ms = <50>;
            key-positions = <27 28>;  // D+F (C+D en Colemak-DH)
            bindings = <&macro_braces>;
            layers = <0>;
        };

        combo_brackets {
            timeout-ms = <50>;
            key-positions = <37 38>;  // Z+X
            bindings = <&macro_brackets>;
            layers = <0>;
        };

        combo_parens {
            timeout-ms = <50>;
            key-positions = <15 16>;  // F+P
            bindings = <&macro_parens>;
            layers = <0>;
        };

        // Programming arrows
        combo_arrow {
            timeout-ms = <50>;
            key-positions = <33 34>;  // K+H
            bindings = <&macro_arrow>;
            layers = <0>;
        };

        combo_fat_arrow {
            timeout-ms = <50>;
            key-positions = <21 22>;  // Y+;
            bindings = <&macro_fat_arrow>;
            layers = <0>;
        };

        // Quick delete word
        combo_del_word {
            timeout-ms = <50>;
            key-positions = <32 33>;  // H+K (inverted for Colemak)
            bindings = <&kp LC(BSPC)>;
            layers = <0>;
        };

        // Caps Word (ambos shifts)
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <28 31>;  // Ambos SHIFT en home row
            bindings = <&caps_word>;
            layers = <0>;
        };

        // Tab (Q+W)
        combo_tab {
            timeout-ms = <50>;
            key-positions = <13 14>;  // Q+W
            bindings = <&kp TAB>;
            layers = <0>;
        };

        // Enter (U+Y)
        combo_enter {
            timeout-ms = <50>;
            key-positions = <20 21>;  // U+Y
            bindings = <&kp ENTER>;
            layers = <0>;
        };

        // Backspace mejorado (L+U ya es ESC, usamos otro)
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <21 22>;  // Y+;
            bindings = <&kp BSPC>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╭─────────────────────────────────────────────────╮
        // │ 0: COLEMAK-DH BASE                              │
        // ╰─────────────────────────────────────────────────╯
        default_layer {
            label = "COLEMAK";
            bindings = <
&kp ESC         &kp N1               &kp N2           &kp N3           &kp N4             &kp N5      &kp N6     &kp N7              &kp N8            &kp N9            &kp N0                          &kp BSPC
&kp TAB         &kp Q                &kp W            &kp F            &kp P              &kp B       &kp J      &kp L               &kp U             &kp Y             &kp SEMI                        &kp BSLH
&kp DELETE      &hml LEFT_CONTROL A  &hml LEFT_ALT R  &hml LEFT_GUI S  &hml LEFT_SHIFT T  &kp G       &kp M      &hmr RIGHT_SHIFT N  &hmr RIGHT_GUI E  &hmr RIGHT_ALT I  &hmr RIGHT_CONTROL O            &kp SQT
&kp LEFT_SHIFT  &kp Z                &kp X            &kp C            &kp D              &kp V       &kp K      &kp H               &kp COMMA         &kp DOT           &kp FSLH                        &kp MINUS
                                                      &lt 1 TAB        &mkp LCLK          &mkp RCLK   &lt 1 RET  &kp BSPC
                                                                       &kp SPACE          &mo 2       &lt 2 LGUI
            >;
            trackball-bindings = <&tmv_coarse>;
        };

        // ╭─────────────────────────────────────────────────╮
        // │ 1: NUMBERS & SYMBOLS                            │
        // ╰─────────────────────────────────────────────────╯
        num_layer {
            label = "NUM";
            bindings = <
&trans     &trans                &trans           &trans            &trans                &kp CAPS     &trans         &trans              &trans              &trans            &trans                   &kp COLON
&kp GRAVE  &kp EXCL              &kp AT           &kp HASH          &kp DLLR              &kp PRCNT    &kp CARET      &kp N7              &kp N8              &kp N9            &kp ASTRK                &kp PIPE
&trans     &hml LEFT_CONTROL N1  &hml LEFT_ALT N2 &hml LEFT_GUI N3  &hml LEFT_SHIFT N4    &kp N5       &kp PLUS       &hmr RIGHT_SHIFT N4 &hmr RIGHT_GUI N5   &hmr RIGHT_ALT N6 &hmr RIGHT_CONTROL EQUAL &kp AMPS
&trans     &kp LBKT              &kp RBKT         &kp LPAR          &kp RPAR              &kp UNDER    &kp LT         &kp N1              &kp N2              &kp N3            &kp GT                   &kp BSLH
                                                  &trans            &mkp LCLK             &mkp RCLK    &trans         &kp N0
                                                                    &kp BSPC              &trans       &trans
            >;
            trackball-bindings = <&tsl>;
        };

        // ╭─────────────────────────────────────────────────╮
        // │ 2: NAVIGATION & MEDIA                           │
        // ╰─────────────────────────────────────────────────╯
        nav_layer {
            label = "NAV";
            bindings = <
&trans  &trans    &trans     &trans       &trans        &kp PSCRN     &to 4      &trans       &trans       &trans     &trans      &trans
&trans  &kp F1    &kp F2     &kp F3       &kp F4        &kp F5        &kp F6     &kp F7       &kp F8       &kp F9     &kp F10     &kp F11
&trans  &kp HOME  &kp PG_UP  &kp C_PREV   &kp C_PP      &kp C_NEXT    &kp INS    &kp LEFT     &kp DOWN     &kp UP     &kp RIGHT   &kp F12
&trans  &kp END   &kp PG_DN  &kp C_VOL_DN &kp C_MUTE    &kp C_VOL_UP  &trans     &kp C_BRI_DN &kp C_BRI_UP &trans     &trans      &trans
                             &trans       &trans        &trans        &trans     &trans
                                          &trans        &trans        &trans
            >;
            trackball-bindings = <&tsl>;
        };

        // ╭─────────────────────────────────────────────────╮
        // │ 3: SYSTEM & BLUETOOTH (Layer 1 + 2)            │
        // ╰─────────────────────────────────────────────────╯
        system_layer {
            label = "SYS";
            bindings = <
&bootloader &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans       &bootloader
&reset      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &reset
&trans      &tog 4       &trans       &trans       &trans       &bt BT_CLR     &bt BT_CLR   &trans       &trans       &trans       &tog 4       &trans
&trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans       &trans
                                      &trans       &trans       &trans         &trans       &trans
                                                   &trans       &trans         &trans
            >;
            trackball-bindings = <&tmv_coarse>;
        };

        // ╭─────────────────────────────────────────────────╮
        // │ 4: GAMING QWERTY (Sin Home Row Mods)          │
        // ╰─────────────────────────────────────────────────╯
        gaming_layer {
            label = "QWERTY";
            bindings = <
&kp ESC         &kp N1        &kp N2        &kp N3        &kp N4        &kp N5      &kp N6     &kp N7        &kp N8        &kp N9        &kp N0          &kp BSPC
&kp TAB         &kp Q         &kp W         &kp E         &kp R         &kp T       &kp Y      &kp U         &kp I         &kp O         &kp P           &kp BSLH
&kp DELETE      &kp A         &kp S         &kp D         &kp F         &kp G       &kp H      &kp J         &kp K         &kp L         &kp SEMI        &kp SQT
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C         &kp V         &kp B       &kp N      &kp M         &kp COMMA     &kp DOT       &kp FSLH        &kp MINUS
                                            &lt 5 TAB     &mkp LCLK     &mkp RCLK   &lt 5 RET  &kp BSPC
                                                          &kp SPACE     &mo 6       &lt 6 LGUI
            >;
            trackball-bindings = <&tmv_coarse>;
        };

        // ╭─────────────────────────────────────────────────╮
        // │ 5: GAMING NUMBERS & SYMBOLS                     │
        // ╰─────────────────────────────────────────────────╯
        gaming_num_layer {
            label = "G-NUM";
            bindings = <
&trans     &trans    &trans    &trans    &trans    &kp CAPS     &trans         &trans    &trans    &trans    &trans        &kp COLON
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET      &kp N7    &kp N8    &kp N9    &kp ASTRK     &kp PIPE
&trans     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp PLUS       &kp N4    &kp N5    &kp N6    &kp EQUAL     &kp AMPS
&trans     &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR  &kp UNDER    &kp LT         &kp N1    &kp N2    &kp N3    &kp GT        &kp BSLH
                               &trans    &mkp LCLK &mkp RCLK    &trans         &kp N0
                                         &kp BSPC  &trans       &trans
            >;
            trackball-bindings = <&tsl>;
        };

        // ╭─────────────────────────────────────────────────╮
        // │ 6: GAMING NAVIGATION & MEDIA                    │
        // ╰─────────────────────────────────────────────────╯
        gaming_nav_layer {
            label = "G-NAV";
            bindings = <
&trans  &trans    &trans     &trans       &trans        &kp PSCRN     &to 0      &trans       &trans       &trans     &trans      &trans
&trans  &kp F1    &kp F2     &kp F3       &kp F4        &kp F5        &kp F6     &kp F7       &kp F8       &kp F9     &kp F10     &kp F11
&trans  &kp HOME  &kp PG_UP  &kp C_PREV   &kp C_PP      &kp C_NEXT    &kp INS    &kp LEFT     &kp DOWN     &kp UP     &kp RIGHT   &kp F12
&trans  &kp END   &kp PG_DN  &kp C_VOL_DN &kp C_MUTE    &kp C_VOL_UP  &trans     &kp C_BRI_DN &kp C_BRI_UP &trans     &trans      &trans
                             &trans       &trans        &trans        &trans     &trans
                                          &trans        &trans        &trans
            >;
            trackball-bindings = <&tsl>;
        };
    };
};
